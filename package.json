{
  "name": "milsymbol-sidc",
  "version": "0.2.0",
  "description": "Fluent TypeScript builder for MIL-STD-2525E / APP-6 numeric (20-character) SIDC strings, for use with milsymbol.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test dist/test/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" package.json tsconfig.json \".github/**/*.yml\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" package.json tsconfig.json \".github/**/*.yml\"",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "milsymbol",
    "sidc",
    "symbol-identification-code",
    "mil-std-2525",
    "mil-std-2525e",
    "milstd2525",
    "milstd2525e",
    "app6",
    "app-6",
    "app6e",
    "nato",
    "joint-military-symbology",
    "military",
    "military-symbology",
    "symbology",
    "tactical-graphics",
    "c2",
    "typescript",
    "builder",
    "fluent-api"
  ],
  "license": "MIT",
  "author": "Stuart Harding",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/psylsph/milsymbol-sidc.git"
  },
  "bugs": {
    "url": "https://github.com/psylsph/milsymbol-sidc/issues"
  },
  "homepage": "https://github.com/psylsph/milsymbol-sidc#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0"
  }
}
